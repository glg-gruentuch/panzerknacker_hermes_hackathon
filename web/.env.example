# live (default): the FastAPI backend at /api.
# static: exported JSON files in app/data/ next to the app (used by npm run build:static).
# mock: built-in sample data for UI work without the backend.
VITE_API_MODE=live

# Where the backend listens. Only used by the dev server proxy (vite.config.ts).
VITE_BACKEND_URL=http://localhost:8000
