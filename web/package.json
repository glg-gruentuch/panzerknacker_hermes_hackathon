{
  "name": "knowledge-across-time-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "examples": "node scripts/export-examples.mjs",
    "dev:mock": "VITE_API_MODE=mock vite",
    "build:static": "tsc --noEmit && VITE_API_MODE=static vite build --outDir ../deliverables/website/app --emptyOutDir",
    "build:cloudflare": "tsc --noEmit && VITE_API_MODE=mock vite build"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
