// Cloudflare Workers config: serves the built site in dist/ as static assets.
// Deploy with `npm run deploy` (needs `npx wrangler login` or CLOUDFLARE_API_TOKEN).
{
  "name": "knowledge-across-time",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
