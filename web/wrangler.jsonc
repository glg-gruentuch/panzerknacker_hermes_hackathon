// Cloudflare Workers config: serves the built site in dist/ as static assets.
// Cloudflare builds this from the landing-page branch. The name must match the Worker name.
{
  "name": "panzerknacker-hermes-hackathon",
  "compatibility_date": "2026-09-01",
  // Cloudflare does not run the Python backend, so the deployed site uses the sample data
  // (VITE_API_MODE=mock) until the static export exists. `wrangler deploy` runs this first.
  "build": {
    "command": "npm run build:cloudflare"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
