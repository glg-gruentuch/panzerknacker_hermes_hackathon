// Cloudflare Workers config: serves the built site in dist/ as static assets.
// Cloudflare builds this from the landing-page branch. The name must match the Worker name.
// Requests to /api/* run worker/index.ts first, which forwards /api/chat to the chat backend.
{
  "name": "panzerknacker-hermes-hackathon",
  "compatibility_date": "2026-09-01",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
