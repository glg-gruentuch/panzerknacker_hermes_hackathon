// Cloudflare Workers config: serves the built site in dist/ as static assets.
// Cloudflare builds this from the landing-page branch. The name must match the Worker name.
{
  "name": "panzerknacker-hermes-hackathon",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
