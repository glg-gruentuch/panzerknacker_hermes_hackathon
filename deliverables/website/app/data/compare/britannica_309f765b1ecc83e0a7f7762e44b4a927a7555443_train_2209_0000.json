    "passages": [
      {
        "id": "W1",
        "text": "6°31′40″S 106°40′20″E / 6.5278048°S 106.6721078°E"
      },
      {
        "id": "W2",
        "text": "Kebon Kopi I also known as Tapak Gajah inscription (elephant footprint inscription), is one of several inscriptions dated from the era of Tarumanagara Kingdom circa 5th century. The inscription bearing the image of elephant footprint, which was copied from the elephant ride of King Purnawarman of Tarumanagara, which is equated with Airavata, the elephant vahana (vehicle) of Indra.: 16"
      },
      {
        "id": "W3",
        "text": "The inscription was discovered in Kebon Kopi village, Bogor, near Kebon Kopi II inscription, and named as such to differ it from this later inscription dated from Sunda Kingdom era."
      },
      {
        "id": "W4",
        "text": "This inscription is written with Pallawa script in Sanskrit which are arranged into the form of the Anustubh metrum Shloka, which is flanked by a pair of carved images of the elephant's foot."
      },
      {
        "id": "W5",
        "text": "Transcription: ~ ~ jayavisalasya Tarumendrasya hastinah ~ ~ Airwavatabhasya vibhatidam ~ padadvayam"
      },
      {
        "id": "W6",
        "text": "Translation: \"Behold, here it looks like a pair of feet...like Airavata, the elephant ride of the great Taruma ruler in... and (?) glory\""
      },
      {
        "id": "W7",
        "text": "H.P. Hoepermans \"Hindoe-Oudheden va Java (1864)\" ROD 1913:74"
      },
      {
        "id": "W8",
        "text": "J.F.G. Brumund \"Bijdragen tot de kennis va het Hindoeisme op Java\" VBG. XXXIII 1868:63-64"
      },
      {
        "id": "W9",
        "text": "A.B. Cohen Stuart \"Heilige Voetsporen op Java\" BKI 3(X) 1875:163-168. Juga di bahasa Inggris berjudul: \"Sacred Footprints in Java\" Indian AntiQuary IV. 1875:355-dst"
      },
      {
        "id": "W10",
        "text": "H. Kern \"Eenige Oude Sanskrit-Opschrifte n van 't Maleische-schiereil and\" VMKAWL 3(1).1884:9"
      },
      {
        "id": "W11",
        "text": "P.J. Veth, Java II. 1878:46; I.1896:27"
      },
      {
        "id": "W12",
        "text": "R.D.M. Verbeek \"Oudheden van Java\" VBG. XLVI. 1891:30-31."
      },
      {
        "id": "W13",
        "text": "J. Ph. Vogel \"the Earliest Sanskrit Inscription opsachriften of Java\" POD. I. 1925:27-28. Plate 32,33."
      },
