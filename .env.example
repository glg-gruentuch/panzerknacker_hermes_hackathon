# Shared event services. These routes require no participant API key.
WIKIPEDIA_API_URL=https://port8000-rks0xavparpzq59.tunnel.applications.uk-south2.nebius.cloud
PARSE_BASE_URL=https://port8000-kh2kceraevwe0k1.tunnel.applications.uk-south2.nebius.cloud/v1
PARSE_MODEL=nvidia/nemotron-3.5-parse
PARSE_API_KEY=

# Path to the hermes binary when it is not on PATH (handoff 2, B5).
# The agent runner checks this variable first, then PATH.
HERMES_BIN=

# Set this URL after you deploy the embedder and reranker in your Nebius project.
RETRIEVAL_BASE_URL=http://127.0.0.1:8000/v1
RETRIEVAL_API_KEY=
# Hosted alternative without a GPU. See docs/nim-gateway.md.
# NVIDIA_API_KEY=
# NIM_EMBED_URL=https://integrate.api.nvidia.com/v1/embeddings
# NIM_RERANK_URL=https://ai.api.nvidia.com/v1/retrieval/nvidia/llama-nemotron-rerank-vl-1b-v2/reranking
# NIM_GATEWAY_TOKEN=
# Record your image choice. Export it for Docker as shown in docs/model-service.md.
RETRIEVAL_IMAGE=

# Create a separate Nebius Token Factory account and supply your own API key.
SUPER_BASE_URL=https://api.tokenfactory.nebius.com/v1
SUPER_MODEL=nvidia/Nemotron-3.5-Super-VL
SUPER_API_KEY=

CHALLENGE_DB_PATH=data/team.lancedb
